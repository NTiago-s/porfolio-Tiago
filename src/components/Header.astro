---
import { NAVIGATION, SITE } from "../data/portfolio";
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-ink/72 backdrop-blur-xl">
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8"
    aria-label="Navegacion principal"
  >
    <a
      href="#contenido"
      class="group inline-flex min-h-11 items-center gap-3 rounded-full border border-white/10 bg-white/[0.03] px-3 py-2 text-sm font-semibold text-bone transition duration-200 hover:border-cyan/35 hover:bg-cyan/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan/70"
      aria-label={`${SITE.name}, ir al inicio`}
    >
      <span
        class="grid size-8 place-items-center rounded-full border border-cyan/30 bg-cyan/10 font-mono text-xs text-cyan shadow-neon"
        aria-hidden="true"
      >
        TN
      </span>
      <span class="hidden sm:inline">{SITE.name}</span>
    </a>

    <div class="flex items-center gap-1 overflow-x-auto rounded-full border border-white/10 bg-white/[0.03] p-1 text-sm text-smoke">
      {
        NAVIGATION.map(({ href, label }) => (
          <a
            href={href}
            class="min-h-10 whitespace-nowrap rounded-full px-3 py-2 transition duration-200 hover:bg-white/10 hover:text-bone focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan/70 sm:px-4"
          >
            {label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
